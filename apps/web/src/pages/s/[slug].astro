---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Zap, ScanSearch, Network, BrainCircuit, ShieldCheck, CheckCircle2, Link2, ChevronRight, BookOpen, Info } from 'lucide-react';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import StatePanel from '../../components/scenario/StatePanel.astro';
import Callout from '../../components/scenario/Callout.astro';
import AnatomyBlock from '../../components/anatomy/AnatomyBlock.astro';
import StepWalkthrough from '../../components/walkthrough/StepWalkthrough';
import TerminalReplay from '../../components/replay/TerminalReplay';
import { SeverityBadge, CommandWell, Prose, CategoryIcon } from '../../components/ui/ui';
import { ACCENTS, SEVERITY } from '../../lib/theme';
import { moduleById } from '../../data/modules';
import { buildAnatomy } from '../../lib/anatomy';
import { assertContentValid } from '../../lib/contentChecks';

export async function getStaticPaths() {
  await assertContentValid();
  const scenarios = await getCollection('scenarios', (s) => !s.data.draft);
  return scenarios.map((scenario) => ({ params: { slug: scenario.id }, props: { scenario } }));
}

interface Props {
  scenario: CollectionEntry<'scenarios'>;
}
const { scenario } = Astro.props;
const s = scenario.data;
const module = moduleById(s.module)!;
const accent = ACCENTS[module.color];
const { Content } = await render(scenario);
const anatomy = await buildAnatomy(s.primaryCommand, s.anatomy);

const all = await getCollection('scenarios', (x) => !x.data.draft);
const related = s.related.map((id) => all.find((x) => x.id === id)).filter((x): x is CollectionEntry<'scenarios'> => Boolean(x));

const commands = await getCollection('commands');
const usedPrograms = new Set(anatomy.tokens.filter((t) => t.kind === 'program').map((t) => t.text));
for (const step of s.steps) if (step.command) (await buildAnatomy(step.command)).tokens.filter((t) => t.kind === 'program').forEach((t) => usedPrograms.add(t.text));
const relatedCommands = commands.filter((c) => usedPrograms.has(c.data.name) || c.data.scenarios.includes(scenario.id));
const number = String(s.number).padStart(2, '0');
---

<Base title={s.title} description={`${s.quote} — step-by-step fix: ${s.primaryCommand}`} current="scenarios">
  <div class="max-w-5xl mx-auto px-4 sm:px-8 py-8 sm:py-10 flex flex-col gap-8 sm:gap-10">
    <Breadcrumbs items={[{ label: module.name, href: `/m/${module.id}` }, { label: `#${number}: ${s.title}` }]} back={{ href: `/m/${module.id}`, label: 'Back to module' }} />

    <section class="card relative overflow-hidden p-6 sm:p-10 space-y-6">
      <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full blur-3xl pointer-events-none bg-primary-container/12"></div>
      <div class="relative flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-2.5 py-1 rounded-md bg-surface-high label-caps text-primary">Scenario {number}</span>
          <a href={`/m/${module.id}`} class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-lowest font-mono text-[11px] ${accent.text} hover:brightness-125`}>
            <CategoryIcon name={module.icon} className="h-3.5 w-3.5" />
            {module.name}
          </a>
        </div>
        <SeverityBadge severity={s.severity} long />
      </div>
      <div class="relative space-y-3">
        <h1 class="text-3xl sm:text-[2.75rem] font-bold leading-[1.15] tracking-[-0.02em]">{s.title}</h1>
        <p class="text-base sm:text-lg text-on-surface-variant italic">“{s.quote}”</p>
      </div>
      <div class="relative flex flex-col gap-2">
        <div class="flex items-center gap-1.5 label-caps text-secondary">
          <Zap className="h-3.5 w-3.5" />
          Primary command
        </div>
        <CommandWell command={s.primaryCommand} size="lg" label="Copy" client:visible />
      </div>
    </section>

    {s.cautions.length > 0 && <div class="space-y-3">{s.cautions.map((c) => <Callout type={c.type} text={c.text} />)}</div>}

    <section class="card p-5 sm:p-8 space-y-6">
      <div class="flex items-center gap-2">
        <ScanSearch className="h-5 w-5 text-primary" />
        <h2 class="text-[22px] font-semibold">The Situation</h2>
      </div>
      <div class="md max-w-3xl"><Content /></div>

      <div class="space-y-3">
        <div class="flex items-center gap-2 label-caps text-outline">
          <Network className="h-4 w-4 text-tertiary" />
          System state
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <StatePanel spec={s.before} which="before" label={s.stateLabels?.[0]} />
          <StatePanel spec={s.after} which="after" label={s.stateLabels?.[1]} />
        </div>
      </div>

      <div class="rounded-xl bg-surface-low border border-white/5 p-4 sm:p-5 space-y-3">
        <div class="flex items-center gap-2 font-display font-semibold text-on-surface">
          <BrainCircuit className="h-5 w-5 text-primary" />
          What each part of the command does
        </div>
        <AnatomyBlock data={anatomy} />
      </div>
    </section>

    <StepWalkthrough steps={s.steps} client:visible />

    {s.replay && <TerminalReplay example={s.replay} client:visible />}

    {
      s.avoid.length > 0 && (
        <section class="card p-5 sm:p-8 space-y-5">
          <div class="flex items-center gap-2">
            <ShieldCheck className="h-5 w-5 text-safe" />
            <h2 class="text-[22px] font-semibold">How to Avoid This Next Time</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {s.avoid.map((tip) => (
              <div class="flex items-start gap-3 rounded-xl bg-surface-low border border-white/5 p-4">
                <CheckCircle2 className="h-4 w-4 text-safe shrink-0 mt-0.5" />
                <p class="text-sm text-on-surface-variant leading-relaxed">
                  <Prose text={tip} />
                </p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      relatedCommands.length > 0 && (
        <section class="space-y-4">
          <h2 class="flex items-center gap-2 label-caps text-on-surface">
            <BookOpen className="h-4 w-4 text-tertiary" />
            Commands used here
          </h2>
          <div class="flex flex-wrap gap-2">
            {relatedCommands.map((c) => (
              <a href={`/c/${c.id}`} class="rounded-lg bg-surface-container border border-white/6 hover:border-primary-container/40 transition px-3 py-2 text-[12px]">
                <span class="font-mono text-tertiary">{c.data.name}</span>
                <span class="text-outline ml-2">{c.data.title}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="space-y-4">
          <h2 class="flex items-center gap-2 label-caps text-on-surface">
            <Link2 className="h-4 w-4 text-secondary" />
            Related scenarios
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {related.map((r) => {
              const m = moduleById(r.data.module)!;
              return (
                <a href={`/s/${r.id}`} class="group card card-hover p-4 flex items-center gap-4">
                  <div class="w-10 h-10 rounded-lg bg-surface-high flex items-center justify-center shrink-0">
                    <CategoryIcon name={m.icon} className={`h-5 w-5 ${ACCENTS[m.color].text}`} />
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 font-mono text-[11px]">
                      <span class="text-tertiary">#{String(r.data.number).padStart(2, '0')}</span>
                      <span class={SEVERITY[r.data.severity].text}>{SEVERITY[r.data.severity].label}</span>
                    </div>
                    <div class="font-display font-semibold text-on-surface truncate">{r.data.title}</div>
                    <div class="text-xs text-outline truncate">{r.data.quote}</div>
                  </div>
                  <ChevronRight className="h-4 w-4 text-outline group-hover:text-primary group-hover:translate-x-0.5 transition shrink-0" />
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <p class="flex items-center gap-2 text-xs text-outline">
      <Info className="h-3.5 w-3.5 text-tertiary shrink-0" />
      Commands assume Ubuntu/Debian. PIDs, paths and output are illustrative.
    </p>
  </div>
</Base>
