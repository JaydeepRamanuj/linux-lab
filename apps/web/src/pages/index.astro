---
import Base from '../layouts/Base.astro';
---

<Base title="ShellGyan">
  <section class="max-w-6xl mx-auto px-4 sm:px-8 py-16 sm:py-24 space-y-6">
    <span class="label-caps text-tertiary">Linux command survival guide</span>
    <h1 class="text-4xl sm:text-display font-bold max-w-3xl">Stop searching for the same commands. Know what they do before you run them.</h1>
    <p class="text-on-surface-variant max-w-2xl">
      Problem-first walkthroughs, a safe sandbox, and an explainer that rates any command from read-only to destructive.
      Under construction.
    </p>
    <a href="/preview" class="btn-primary inline-flex px-5 py-2.5 rounded-lg text-sm font-semibold">See the component preview</a>
  </section>
</Base>
