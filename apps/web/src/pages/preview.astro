---
// Dev showcase for the components carried over from GitGyan. Remove once real scenario pages exist.
import Base from '../layouts/Base.astro';
import { SeverityBadge, CommandWell } from '../components/ui/ui';
import StepWalkthrough from '../components/walkthrough/StepWalkthrough';
import TerminalReplay from '../components/replay/TerminalReplay';
import Zones from '../components/widgets/Zones';
import type { ZonesSpec } from '../components/widgets/Zones';
import { SEVERITY_LEVELS } from '../lib/theme';
import type { WalkthroughStep, ReplayExample } from '../lib/types';

const steps: WalkthroughStep[] = [
  {
    title: "Find what's using the port",
    kind: 'readonly',
    command: 'lsof -i :3000',
    output: 'COMMAND   PID  USER  FD  TYPE  NODE NAME\nnode    48213  jd    23u IPv6  TCP  *:3000 (LISTEN)',
    note: 'The PID column is the process ID. Here it is `48213`.'
  },
  { title: 'Stop it gracefully', kind: 'modifies', command: 'kill 48213', note: 'Sends SIGTERM so the server can shut down cleanly.' },
  {
    title: 'Force it only if it refuses',
    kind: 'destructive',
    command: 'kill -9 48213',
    note: 'SIGKILL cannot be caught: unsaved state in that process is lost.'
  }
];

const replay: ReplayExample = {
  context: 'A dev server from yesterday is still holding port 3000.',
  commands: [
    { line: '$ npm run dev', type: 'input' },
    { line: 'Error: listen EADDRINUSE: address already in use :::3000', type: 'output' },
    { line: '$ lsof -i :3000', type: 'input' },
    { line: 'node    48213  jd    23u  IPv6  TCP *:3000 (LISTEN)', type: 'output' },
    { line: '$ kill 48213', type: 'input' },
    { line: '$ npm run dev', type: 'input' },
    { line: 'ready - started server on http://localhost:3000', type: 'output' }
  ]
};

const before: ZonesSpec = {
  kind: 'zones',
  zones: [
    { title: 'Port 3000', items: [{ text: 'node (48213)', tone: 'bad', note: 'old dev server' }] },
    { title: 'Your terminal', items: [{ text: 'npm run dev', tone: 'caution', note: 'EADDRINUSE' }] }
  ]
};
const after: ZonesSpec = {
  kind: 'zones',
  zones: [
    { title: 'Port 3000', items: [{ text: 'node (51022)', tone: 'good', note: 'new dev server' }] },
    { title: 'Stopped', items: [{ text: 'node (48213)', tone: 'ghost' }] }
  ]
};
---

<Base title="Component preview">
  <div class="max-w-4xl mx-auto px-4 sm:px-8 py-10 space-y-8">
    <h1 class="text-3xl font-bold">Component preview</h1>

    <section class="card p-5 sm:p-8 space-y-4">
      <h2 class="text-[22px] font-semibold">Severity badges and command well</h2>
      <div class="flex flex-wrap gap-2">
        {SEVERITY_LEVELS.map((s) => <SeverityBadge severity={s} long />)}
      </div>
      <CommandWell command="sudo lsof -i :3000 && kill -9 48213 # last resort" size="lg" client:visible />
    </section>

    <section class="card p-5 sm:p-8 grid sm:grid-cols-2 gap-4">
      <div class="space-y-2"><span class="label-caps text-danger">Before</span><Zones spec={before} /></div>
      <div class="space-y-2"><span class="label-caps text-safe">After</span><Zones spec={after} /></div>
    </section>

    <StepWalkthrough steps={steps} client:visible />
    <TerminalReplay example={replay} client:visible />
  </div>
</Base>
