---
import { getCollection } from 'astro:content';
import { assertContentValid } from '../../lib/contentChecks';
import type { CollectionEntry } from 'astro:content';
import { Terminal, ListChecks, AlertTriangle, Package, Link2, BookOpen } from 'lucide-react';
import { maxSeverity } from '@shellgyan/core/severity';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import AnatomyBlock from '../../components/anatomy/AnatomyBlock.astro';
import { SeverityBadge, CommandWell, Prose } from '../../components/ui/ui';
import { COMMAND_CATEGORIES, LEVELS } from '../../data/commandCategories';
import { buildAnatomy } from '../../lib/anatomy';

export async function getStaticPaths() {
  await assertContentValid();
  const commands = await getCollection('commands');
  return commands.map((command) => ({ params: { slug: command.id }, props: { command } }));
}

interface Props {
  command: CollectionEntry<'commands'>;
}
const { command } = Astro.props;
const c = command.data;

// The rule engine's verdict is a floor: an example can be rated higher than the content says, never lower.
const examples = await Promise.all(
  c.examples.map(async (e) => {
    const anatomy = await buildAnatomy(e.command);
    return { ...e, anatomy, severity: maxSeverity(e.severity, anatomy.severity) };
  })
);

const allCommands = await getCollection('commands');
const related = c.related.map((name) => allCommands.find((x) => x.data.name === name)).filter((x): x is CollectionEntry<'commands'> => Boolean(x));
const scenarios = (await getCollection('scenarios', (s) => !s.data.draft)).filter((s) => c.scenarios.includes(s.id));
const distros = Object.entries(c.distros ?? {}).filter(([, v]) => v) as [string, string][];
---

<Base title={`${c.name}: ${c.title}`} description={c.summary} current="library">
  <div class="max-w-5xl mx-auto px-4 sm:px-8 py-8 sm:py-10 space-y-8">
    <Breadcrumbs items={[{ label: 'Library', href: '/library' }, { label: c.name }]} back={{ href: '/library', label: 'All commands' }} />

    <section class="card relative overflow-hidden p-6 sm:p-10 space-y-5">
      <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full blur-3xl pointer-events-none bg-tertiary-container/15"></div>
      <div class="relative flex flex-wrap items-center gap-2">
        <span class="px-2.5 py-1 rounded-md bg-surface-high label-caps text-tertiary">{COMMAND_CATEGORIES[c.category]}</span>
        <span class="px-2.5 py-1 rounded-md bg-surface-lowest label-caps text-outline">{LEVELS[c.level]}</span>
      </div>
      <div class="relative space-y-2">
        <h1 class="text-3xl sm:text-[2.75rem] font-bold leading-[1.15] font-mono">{c.name}</h1>
        <p class="text-lg text-on-surface">{c.title}</p>
        <p class="text-on-surface-variant max-w-3xl leading-relaxed"><Prose text={c.summary} /></p>
      </div>
      <div class="relative space-y-2">
        <div class="flex items-center gap-1.5 label-caps text-secondary">
          <Terminal className="h-3.5 w-3.5" />
          Syntax
        </div>
        <div class="well px-4 py-3 font-mono text-[14px] text-on-surface overflow-x-auto">{c.syntax}</div>
      </div>
    </section>

    {
      c.flags.length > 0 && (
        <section class="card p-5 sm:p-8 space-y-4">
          <h2 class="flex items-center gap-2 text-[22px] font-semibold">
            <ListChecks className="h-5 w-5 text-primary" />
            Common flags
          </h2>
          <div class="divide-y divide-white/5 rounded-xl border border-white/5 overflow-hidden">
            {c.flags.map((f) => (
              <div class="grid grid-cols-1 sm:grid-cols-[minmax(10rem,auto)_1fr] gap-1 sm:gap-6 px-4 py-3 bg-surface-low">
                <code class="font-mono text-[13px] text-primary whitespace-nowrap">{f.flag}</code>
                <span class="text-sm text-on-surface-variant">
                  <Prose text={f.meaning} />
                </span>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      examples.length > 0 && (
        <section class="card p-5 sm:p-8 space-y-6">
          <h2 class="flex items-center gap-2 text-[22px] font-semibold">
            <Terminal className="h-5 w-5 text-tertiary" />
            Examples
          </h2>
          {examples.map((e, i) => (
            <div class="flex flex-col gap-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-sm text-on-surface">
                  <Prose text={e.explain} />
                </p>
                <SeverityBadge severity={e.severity} />
              </div>
              <CommandWell command={e.command} client:visible />
              {i === 0 && <AnatomyBlock data={e.anatomy} />}
            </div>
          ))}
        </section>
      )
    }

    {
      c.gotchas.length > 0 && (
        <section class="card p-5 sm:p-8 space-y-4">
          <h2 class="flex items-center gap-2 text-[22px] font-semibold">
            <AlertTriangle className="h-5 w-5 text-caution" />
            Gotchas
          </h2>
          <ul class="space-y-2">
            {c.gotchas.map((g) => (
              <li class="flex items-start gap-3 text-sm text-on-surface-variant leading-relaxed">
                <span class="w-1.5 h-1.5 rounded-full bg-caution mt-2 shrink-0" />
                <Prose text={g} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      distros.length > 0 && (
        <section class="card p-5 sm:p-8 space-y-4">
          <h2 class="flex items-center gap-2 text-[22px] font-semibold">
            <Package className="h-5 w-5 text-secondary" />
            {c.distrosTitle ?? 'Install it'}
          </h2>
          <div class="space-y-2">
            {distros.map(([pm, cmd]) => (
              <div class="flex items-center gap-3">
                <span class="label-caps text-outline w-16 shrink-0">{pm}</span>
                <CommandWell command={cmd} className="flex-1" client:visible />
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      (related.length > 0 || scenarios.length > 0) && (
        <section class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {scenarios.length > 0 && (
            <div class="space-y-3">
              <h2 class="flex items-center gap-2 label-caps text-on-surface">
                <Link2 className="h-4 w-4 text-secondary" />
                Used in scenarios
              </h2>
              {scenarios.map((s) => (
                <a href={`/s/${s.id}`} class="block card card-hover p-4">
                  <div class="font-display font-semibold text-on-surface">{s.data.title}</div>
                  <div class="text-xs text-outline mt-0.5">“{s.data.quote}”</div>
                </a>
              ))}
            </div>
          )}
          {related.length > 0 && (
            <div class="space-y-3">
              <h2 class="flex items-center gap-2 label-caps text-on-surface">
                <BookOpen className="h-4 w-4 text-tertiary" />
                Related commands
              </h2>
              <div class="flex flex-wrap gap-2">
                {related.map((r) => (
                  <a href={`/c/${r.id}`} class="rounded-lg bg-surface-container border border-white/6 hover:border-primary-container/40 transition px-3 py-2 text-[12px]">
                    <span class="font-mono text-tertiary">{r.data.name}</span>
                    <span class="text-outline ml-2">{r.data.title}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </section>
      )
    }
  </div>
</Base>
