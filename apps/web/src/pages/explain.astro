---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Explainer from '../components/explainer/Explainer';
---

<Base
  title="Command explainer"
  description="Paste any shell command and see what each part does and how dangerous it is. Checked locally in your browser."
  current="explain"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-8 sm:py-10 flex flex-col gap-8">
    <Breadcrumbs items={[{ label: 'Explain' }]} />
    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-bold">What does this command do?</h1>
      <p class="text-on-surface-variant max-w-2xl">
        Paste a command an agent wants to run, or one you found online. The rule engine breaks it into parts, rates how risky it is, and
        shows what each piece does, before you run anything.
      </p>
    </div>
    <Explainer client:load />
  </div>
</Base>
