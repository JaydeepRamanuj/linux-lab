---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import { SITE_NAME, TAGLINE, DEFAULT_DESCRIPTION } from '../data/site';

interface Props {
  title: string;
  description?: string;
  current?: 'scenarios' | 'library' | 'learn' | 'explain';
}

const { title, current, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = title === SITE_NAME ? `${SITE_NAME} | ${TAGLINE.replace(/\.$/, '')}` : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <!-- Geist (headlines), Inter (body), JetBrains Mono (code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header current={current} />

    <main class="flex-1 w-full animate-fade-in">
      <slot />
    </main>

    <footer class="border-t border-white/5 bg-surface-lowest">
      <div class="max-w-6xl mx-auto px-4 sm:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-outline">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-primary-container"></span>
          <span class="label-caps text-on-surface-variant">{SITE_NAME}</span>
          <span class="text-outline-variant">•</span>
          <span>{TAGLINE}</span>
        </div>
        <p class="text-center sm:text-right max-w-md">Read what a command does before you run it.</p>
      </div>
    </footer>
  </body>
</html>
