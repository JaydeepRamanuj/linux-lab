---
import { SquareTerminal } from 'lucide-react';
import SearchBar from '../search/SearchBar';

interface Props {
  current?: 'scenarios' | 'library' | 'learn' | 'explain';
}
const { current } = Astro.props;

const NAV = [
  { id: 'scenarios', label: 'Scenarios', href: '/' },
  { id: 'library', label: 'Library', href: '/library' },
  { id: 'learn', label: 'Learn', href: '/learn' },
  { id: 'explain', label: 'Explain', href: '/explain' },
  { id: 'sandbox', label: 'Sandbox', href: null }
];
---

<header class="sticky top-0 z-40 w-full bg-surface/85 backdrop-blur-xl border-b border-white/6 shadow-[0_4px_24px_rgba(0,0,0,0.45)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 h-16 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4 sm:gap-6 min-w-0">
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <div class="w-9 h-9 rounded-lg p-px bg-linear-to-br from-primary-container via-primary-deep to-tertiary shadow-[0_0_16px_rgba(128,131,255,0.3)] group-hover:shadow-[0_0_24px_rgba(76,215,246,0.45)] transition">
          <div class="w-full h-full rounded-[7px] bg-surface-lowest flex items-center justify-center">
            <SquareTerminal className="h-4.5 w-4.5 text-tertiary" />
          </div>
        </div>
        <span class="font-display text-lg font-semibold tracking-tight text-on-surface hidden sm:inline">ShellGyan</span>
      </a>

      <nav class="flex items-center gap-1 p-1 rounded-xl bg-surface-low border border-white/5 overflow-x-auto no-scrollbar" aria-label="Main">
        {
          NAV.map((item) =>
            item.href ? (
              <a
                href={item.href}
                aria-current={current === item.id ? 'page' : undefined}
                class:list={[
                  'px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-[13px] whitespace-nowrap transition',
                  current === item.id
                    ? 'bg-surface-high text-primary font-semibold shadow-inner'
                    : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container'
                ]}
              >
                {item.label}
              </a>
            ) : (
              <span class="px-3 py-1.5 text-xs sm:text-[13px] whitespace-nowrap text-outline-variant cursor-default hidden sm:inline" title="Coming soon">
                {item.label}
              </span>
            )
          )
        }
      </nav>
    </div>

    <div class="hidden md:block w-72">
      <SearchBar hotkey client:idle />
    </div>
  </div>
  <div class="md:hidden px-4 pb-3">
    <SearchBar client:idle />
  </div>
</header>
