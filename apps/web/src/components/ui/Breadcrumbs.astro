---
import { House, ArrowLeft } from 'lucide-react';

interface Props {
  items: { label: string; href?: string }[];
  back?: { href: string; label: string };
}
const { items, back } = Astro.props;
---

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
  <nav class="flex items-center flex-wrap gap-1.5 font-mono text-[12px] text-outline" aria-label="Breadcrumb">
    <a href="/" class="flex items-center gap-1 hover:text-primary transition">
      <House className="h-3.5 w-3.5" />
      Home
    </a>
    {
      items.map((item) => (
        <span class="flex items-center gap-1.5 min-w-0">
          <span class="text-outline-variant">/</span>
          {item.href ? (
            <a href={item.href} class="hover:text-primary transition">
              {item.label}
            </a>
          ) : (
            <span class="text-tertiary truncate max-w-[60vw] sm:max-w-none">{item.label}</span>
          )}
        </span>
      ))
    }
  </nav>
  {
    back && (
      <a href={back.href} class="btn-ghost inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs shrink-0 self-start sm:self-auto">
        <ArrowLeft className="h-3.5 w-3.5" />
        {back.label}
      </a>
    )
  }
</div>
